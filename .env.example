# ==============================================================================
# IncidentMind Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME=IncidentMind
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Groq LLM Configuration
# Model should be configurable; default preferred model per specification
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_MAX_RETRIES=3

# Hindsight Cloud Configuration (Persistent Organizational Memory Layer)
HINDSIGHT_BASE_URL=https://api.hindsight.cloud
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=incidentmind-memory
HINDSIGHT_WORKSPACE_ID=incidentmind-org

# Database Configuration (PostgreSQL)
# Note: PostgreSQL is application state storage, NOT organizational memory.
DATABASE_URL=postgresql+asyncpg://incidentmind:incidentmind@localhost:5432/incidentmind_db
POSTGRES_USER=incidentmind
POSTGRES_PASSWORD=incidentmind
POSTGRES_DB=incidentmind_db
POSTGRES_PORT=5432

# Vector / RAG Reference Documentation Configuration
RAG_DATA_DIR=./data/runbooks

# Incident Simulator Configuration
SIMULATOR_DETERMINISTIC=True

# Azure Monitor Webhook Configuration (Optional)
# If left empty, webhook operates in open development mode without secret enforcement.
AZURE_WEBHOOK_SECRET=
AZURE_DEFAULT_SERVICE=azure-service
AZURE_AUTO_ORCHESTRATE=False
